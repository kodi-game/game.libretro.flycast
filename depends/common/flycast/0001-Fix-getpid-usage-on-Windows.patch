From 84c3e691ccc2cc6b98316ff851f294fa0cdb1ecd Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sat, 22 Aug 2026 18:20:10 -0700
Subject: [PATCH] Fix getpid usage on Windows

---
 core/deps/libzip/mkstemp.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/core/deps/libzip/mkstemp.c b/core/deps/libzip/mkstemp.c
index 2cb1dd2e..cd47d67a 100644
--- a/core/deps/libzip/mkstemp.c
+++ b/core/deps/libzip/mkstemp.c
@@ -43,14 +43,11 @@
 #include <stdio.h>
 #include <stdlib.h>
 
-#if defined(_MSC_VER)
-/* MSVC has no unistd.h; getpid lives in process.h as _getpid. */
+#if defined(_WIN32)
+/* The Windows CRT declares _getpid in process.h. */
 #include <process.h>
 #define getpid _getpid
 #else
-/* POSIX targets plus MinGW all provide getpid() via unistd.h. It was
- * previously only included for Apple/Switch, which left getpid implicitly
- * declared everywhere else -- tolerated by glibc but a hard error on MinGW. */
 #include <unistd.h>
 #endif
 
