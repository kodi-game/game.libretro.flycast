From ac33322915e5e1b8ca8d7257924aa8b371a93757 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 21 Sep 2026 07:42:28 -0700
Subject: [PATCH] Fix version

---
 CMakeLists.txt              | 9 +++++++++
 core/version.h.in           | 1 +
 shell/libretro/libretro.cpp | 5 +----
 3 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 365c023e4..c96ffab5c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -153,6 +153,15 @@ else()
 	set(GIT_HASH "000000000")
 endif()
 
+# Libretro frontends require a numeric version without Git revision details.
+if(GIT_VERSION MATCHES "^[vV]?([0-9]+\\.[0-9]+\\.[0-9]+)($|-)")
+	set(FLYCAST_VERSION "${CMAKE_MATCH_1}")
+elseif(GIT_VERSION MATCHES "^[vV]?([0-9]+\\.[0-9]+)($|-)")
+	set(FLYCAST_VERSION "${CMAKE_MATCH_1}.0")
+else()
+	set(FLYCAST_VERSION "0.0.0")
+endif()
+
 if(WINDOWS_STORE)
 	string(REGEX REPLACE "[Vv]" "" MS_VERSION ${GIT_VERSION})
 	string(REPLACE "-" "." MS_VERSION ${MS_VERSION})
diff --git a/core/version.h.in b/core/version.h.in
index e37579f26..401e71eec 100644
--- a/core/version.h.in
+++ b/core/version.h.in
@@ -1,5 +1,6 @@
 #pragma once
 
+#define FLYCAST_VERSION	"@FLYCAST_VERSION@"
 #define GIT_VERSION		"@GIT_VERSION@"
 #define GIT_HASH		"@GIT_HASH@"
 #define BUILD_DATE		"@BUILD_TIMESTAMP@"
\ No newline at end of file
diff --git a/shell/libretro/libretro.cpp b/shell/libretro/libretro.cpp
index a4444c9a6..fe6884b3b 100644
--- a/shell/libretro/libretro.cpp
+++ b/shell/libretro/libretro.cpp
@@ -2558,10 +2558,7 @@ const char* retro_get_system_directory()
 void retro_get_system_info(struct retro_system_info *info)
 {
    info->library_name = "Flycast";
-#ifndef GIT_VERSION
-#define GIT_VERSION "undefined"
-#endif
-   info->library_version = GIT_VERSION;
+   info->library_version = FLYCAST_VERSION;
    info->valid_extensions = "chd|cdi|elf|cue|gdi|lst|bin|dat|zip|7z|m3u";
    info->need_fullpath = true;
    info->block_extract = true;
-- 
2.50.1 (Apple Git-155)

