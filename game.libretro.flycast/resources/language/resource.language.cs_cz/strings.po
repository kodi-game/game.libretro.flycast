msgctxt "#30076"
msgid "Force use of high-level emulation BIOS."
msgstr "Vynutit použití HLE BIOSu."

msgctxt "#30077"
msgid "Per-Strip (fast, least accurate)"
msgstr "Pro každý pás trojúhelníků (rychlé, nejméně přesné)"

msgctxt "#30078"
