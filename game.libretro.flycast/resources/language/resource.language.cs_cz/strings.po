msgctxt "#30273"
msgid "Preload Custom Textures"
msgstr "Přednačítat vlastní textury"

msgctxt "#30274"
msgid "Preload custom textures at game start. May improve performance but increases memory usage."
msgstr "Přednačítat vlastní textury při spuštění hry. Může zlepšit výkon, ale zvyšuje využití paměti."

msgctxt "#30275"
msgid "Every time a new texture is used by the game, it will be saved as a .png file in the 'system/dc/texdump/<game-id>/' folder."
msgstr "Pokaždé, když hra použije novou texturu, bude uložena jako soubor .png do složky 'system/dc/texdump/<game-id>/'."

msgctxt "#30276"
msgid "Dump Replaced Textures"
msgstr "Exportovat nahrazené textury"

