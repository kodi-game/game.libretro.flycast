msgctxt "#30151"
msgid "Allow Arcade Service Buttons"
msgstr "Povolit servisní tlačítka arkádových automatů"

msgctxt "#30152"
msgid "Enables SERVICE button for arcade games, to enter cabinet settings."
msgstr "Povoluje tlačítko SERVICE pro arkádové hry, kterým lze otevřít nastavení automatu."

msgctxt "#30153"
msgid "Set NAOMI Games to Free Play"
msgstr "Nastavit hry NAOMI na bezplatné hraní"

msgctxt "#30154"
msgid "Modify to coin settings of the game to free play."
msgstr "Změní nastavení vkládání mincí ve hře na bezplatné hraní."

