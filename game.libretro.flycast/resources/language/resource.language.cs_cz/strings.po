msgstr "Emulace širokopásmového adaptéru"

msgctxt "#30159"
msgid "Emulate the Ethernet broadband adapter instead of the modem. (Restart Required)"
msgstr "Emulovat širokopásmový ethernetový adaptér namísto modemu. (Vyžaduje restart)"

msgctxt "#30160"
msgid "Enable UPnP"
msgstr "Povolit UPnP"

msgctxt "#30161"
msgid "Use UPnP to automatically configure your Internet router for online games."
msgstr "Používat UPnP k automatickému nastavení internetového routeru pro online hry."

