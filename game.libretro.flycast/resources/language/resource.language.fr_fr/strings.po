msgid "Device in Expansion Slot B2"
msgstr "Périphérique dans le port d'extension B2"

msgctxt "#30296"
msgid "Select the device plugged in the expansion slot B2 (port B slot 2)."
msgstr "Sélectionner le périphérique branché dans le port d'extension B2 (port B emplacement 2)."

