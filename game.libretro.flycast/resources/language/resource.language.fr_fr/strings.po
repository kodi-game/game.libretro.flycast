msgstr "Périphérique dans le port d'extension A2"

msgctxt "#30292"
msgid "Select the device plugged in the expansion slot A2 (port A slot 2)."
msgstr "Sélectionner le périphérique branché dans le port d'extension A2 (port A emplacement 2)."

msgctxt "#30293"
msgid "Device in Expansion Slot B1"
msgstr "Périphérique dans le port d'extension B1"

msgctxt "#30294"
msgid "Select the device plugged in the expansion slot B1 (port B slot 1)."
msgstr "Sélectionner le périphérique branché dans le port d'extension B1 (port B emplacement 1)."

