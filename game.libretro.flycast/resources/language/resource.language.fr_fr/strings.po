msgid "Device in Expansion Slot C1"
msgstr "Périphérique dans le port d'extension C1"

msgctxt "#30298"
msgid "Select the device plugged in the expansion slot C1 (port C slot 1)."
msgstr "Sélectionner le périphérique branché dans le port d'extension C1 (port C emplacement 1)."

msgctxt "#30299"
msgid "Device in Expansion Slot C2"
msgstr "Périphérique dans le port d'extension C2"

msgctxt "#30300"
msgid "Select the device plugged in the expansion slot C2 (port C slot 2)."
msgstr "Sélectionner le périphérique branché dans le port d'extension C2 (port C emplacement 2)."

msgctxt "#30301"
msgid "Device in Expansion Slot D1"
msgstr "Périphérique dans le port d'extension D1"

msgctxt "#30302"
msgid "Select the device plugged in the expansion slot D1 (port D slot 1)."
msgstr "Sélectionner le périphérique branché dans le port d'extension D1 (port D emplacement 1)."

