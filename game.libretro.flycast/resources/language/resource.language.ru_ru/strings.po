msgctxt "#30148"
msgid "Configure region, language, BIOS and base hardware settings."
msgstr "Настройка региона, языка, BIOS и базовых параметров оборудования."

msgctxt "#30149"
msgid "Changes the language used by the BIOS and by any games that contain multiple languages."
msgstr "Изменяет язык, используемый BIOS и играми, содержащими несколько языков."

msgctxt "#30150"
msgid "HLE BIOS (Restart Required)"
msgstr "HLE BIOS (требуется перезапуск)"

msgctxt "#30151"
msgid "Allow Arcade Service Buttons"
msgstr "Разрешить кнопки обслуживания автомата"

msgctxt "#30152"
msgid "Enables SERVICE button for arcade games, to enter cabinet settings."
msgstr "Включает кнопку SERVICE для аркадных игр для входа в настройки автомата."

msgctxt "#30153"
msgid "Set NAOMI Games to Free Play"
msgstr "Установить для игр NAOMI режим бесплатной игры"

msgctxt "#30154"
msgid "Modify to coin settings of the game to free play."
msgstr "Изменить настройки монет игры на режим бесплатной игры."

msgctxt "#30155"
msgid "Coin Limit"
msgstr "Лимит монет"

msgctxt "#30156"
msgid "Disable coin insertion after defined limit."
msgstr "Отключить вставку монет после заданного лимита."

