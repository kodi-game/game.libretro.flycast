msgstr "отключено"

msgctxt "#30158"
msgid "Broadband Adapter Emulation"
msgstr "Эмуляция широкополосного адаптера"

msgctxt "#30159"
msgid "Emulate the Ethernet broadband adapter instead of the modem. (Restart Required)"
msgstr "Эмулировать широкополосный адаптер Ethernet вместо модема. (Требуется перезапуск)"

msgctxt "#30160"
msgid "Enable UPnP"
msgstr "Включить UPnP"

msgctxt "#30161"
msgid "Use UPnP to automatically configure your Internet router for online games."
msgstr "Использовать UPnP для автоматической настройки вашего интернет-роутера для сетевых игр."

msgctxt "#30162"
msgid "Use DCNet"
msgstr "Использовать DCNet"

msgctxt "#30163"
msgid "Use the DCNet cloud service for Dreamcast Internet access."
msgstr "Использовать облачную службу DCNet для доступа Dreamcast в интернет."

msgctxt "#30164"
msgid "Configure resolution, order-independent transparency and visual effect settings."
msgstr "Настройка разрешения, независимой от порядка прозрачности и параметров визуальных эффектов."

