msgctxt "#30083"
msgid "Enable emulation of the Dreamcast's audio DSP (digital signal processor). Improves the accuracy of generated sound, but increases performance requirements."
msgstr "Zapne emuláciu audio DSP Dreamcastu (digital signal processor). Zlepšuje presnosť generovaného zvuku, ale zvyšuje nároky na výkon."

msgctxt "#30084"
msgid "Runs the GPU and CPU on different threads. Highly recommended."
msgstr "Spúšťa GPU a CPU v rôznych vláknach. Veľmi odporúčané."

msgctxt "#30085"
msgid "Waits for the GPU to finish rendering the previous frame instead of dropping the current one. Note: This setting only applies when 'Threaded Rendering' is enabled."
msgstr ""

