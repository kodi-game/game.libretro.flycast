msgstr "Genişletme yuvası C1 için takılı cihazı seçin (port C yuva 1)."

msgctxt "#30299"
msgid "Device in Expansion Slot C2"
msgstr "Genişletme Yuvası Cihaz C2"

msgctxt "#30300"
msgid "Select the device plugged in the expansion slot C2 (port C slot 2)."
msgstr "Genişletme yuvası C2 için takılı cihazı seçin (port C yuva 2)."

msgctxt "#30301"
msgid "Device in Expansion Slot D1"
msgstr "Genişletme Yuvası Cihaz D1"

msgctxt "#30302"
msgid "Select the device plugged in the expansion slot D1 (port D slot 1)."
msgstr "Genişletme yuvası D1 için takılı cihazı seçin (port D yuva 1)."

