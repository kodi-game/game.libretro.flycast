msgstr "Genişletme Yuvası Cihaz A1"

msgctxt "#30289"
msgid "Select the device plugged in the expansion slot A1 (port A slot 1)."
msgstr "Genişletme yuvası A1 için takılı cihazı seçin (port A yuva 1)."

